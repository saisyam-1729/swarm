# PURPOSE: Local backend env placeholders (copy to backend/.env — never commit secrets).

# Cloud or LAN PostgreSQL / TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swarm
DB_USER=swarm
DB_PASSWORD=
DB_SSL_MODE=prefer
# Or full URL (TLS):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/swarm?sslmode=require
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_INIT_FAIL_TIMEOUT_MS=30000

JWT_SECRET=change-me-to-a-long-random-jwt-secret

SWARM_BOOTSTRAP_ADMIN_EMAIL=
SWARM_BOOTSTRAP_ADMIN_PASSWORD=
SWARM_SEED_DEMO_ACCOUNTS=false
SWARM_SEED_DEMO_PASSWORD=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWARM_CORS_ALLOW_ANY_HTTP=true

# Dev: true. Demo/prod profile defaults false via application-prod.yml.
SWARM_IOT_COMPAT_LEGACY=true
SWARM_IOT_MAX_READINGS=64
SWARM_RATE_INGEST_PER_MIN=120
SWARM_RATE_LOGIN_PER_MIN=20

MQTT_ENABLED=false
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=swarm-backend
MQTT_SWARM_TOPIC=swarm/v1/+/+/+/telemetry
MQTT_USER=
MQTT_PASSWORD=
MQTT_TRUST_BROKER_ACLS=true
MQTT_INGEST_MAX_ATTEMPTS=3
MQTT_INGEST_RETRY_DELAY_MS=200

SWARM_MQTT_PUBLIC_HOST=127.0.0.1
SWARM_MQTT_PUBLIC_PORT=1884

NOVA_SPACE_OP_ENABLED=true
NOVA_LLM_API_KEY=
