# PURPOSE: Documents required Docker Compose / Pi demo environment variables without real secrets.
# Copy to .env and fill in values. Never commit .env.

# PostgreSQL — local Compose defaults. For Pi→cloud, set SPRING_DATASOURCE_URL or DB_HOST to the cloud DB.
DB_NAME=swarm
DB_USER=swarm
DB_PASSWORD=change-me-strong-database-password
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=disable
# Cloud example (overrides host/port composition when set on the process):
# SPRING_DATASOURCE_URL=jdbc:postgresql://cloud-host:5432/swarm?sslmode=require
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_INIT_FAIL_TIMEOUT_MS=30000

# JWT signing key (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# First-run Control Center admin (created only when no CONTROL_CENTER_ADMIN exists)
SWARM_BOOTSTRAP_ADMIN_EMAIL=
SWARM_BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma-separated exact origins).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
# false recommended for demo/production; true helps LAN Vite/dev.
SWARM_CORS_ALLOW_ANY_HTTP=false

# Demo/prod: require device credentials on REST ingest (dev profile default remains true).
SWARM_IOT_COMPAT_LEGACY=false

# Optional demo SUPER_ADMIN logins (never created unless both are set)
SWARM_SEED_DEMO_ACCOUNTS=false
SWARM_SEED_DEMO_PASSWORD=

# MQTT — enable for Pi/ESP32 demo. Mosquitto rejects anonymous publishers.
MQTT_ENABLED=true
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=swarm-backend
MQTT_SWARM_TOPIC=swarm/v1/+/+/+/telemetry
MQTT_USER=swarm-backend
MQTT_PASSWORD=changeme-mqtt-backend
MQTT_TRUST_BROKER_ACLS=true
MQTT_INGEST_MAX_ATTEMPTS=3
# Public host/port exported to hardware provisioning (LAN-reachable for ESP32)
SWARM_MQTT_PUBLIC_HOST=127.0.0.1
SWARM_MQTT_PUBLIC_PORT=1884

# Optional emPOWER partner sandbox org/key (leave false on a clean start)
SWARM_PARTNER_SANDBOX_ENABLED=false
