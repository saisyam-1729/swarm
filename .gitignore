# PURPOSE: SWARM project file .gitignore.
# Dependencies
node_modules/
target/
dist/
build/

# Environment
.env
.env.local
.env.rpi
*.env
backend/.env
frontend/.env.production

# Mosquitto password file (generated; never commit real hashes)
docker/mosquitto/passwd

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Reports output
reports/

# Docker volumes
mysql_data/

# Local H2 database files (legacy; PostgreSQL is the application database)
backend/data/

# PostgreSQL dumps
backups/

# NOVA reference packs (integrated into app; keep out of git)
nova-op-swarm-pack-*.zip
NOVA_OP_SWARM_PACK/
